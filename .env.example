# ============================================================
# LLM Provider API Keys (fill in the ones you have)
# ============================================================

# OpenAI  — models: gpt-4o, gpt-4o-mini, o3-mini, ...
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini — models: gemini-2.5-flash, gemini-2.5-pro, gemini-3-flash-preview, ...
GOOGLE_API_KEY=your-google-api-key-here

# Anthropic Claude — models: claude-sonnet-4-6, claude-haiku-4-5-20251001, ...
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# DeepSeek — models: deepseek-chat, deepseek-reasoner, ...
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# ============================================================
# LangSmith Observability (optional)
# ============================================================
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=omni-harness
